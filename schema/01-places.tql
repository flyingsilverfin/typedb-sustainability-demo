define

### Places ###

attribute country_name, value string;
attribute province_name, value string;
attribute kabupaten_name, value string;

entity place @abstract;

entity country,
  sub place,
  owns country_name @key;

entity province,
  sub place,
  owns province_name @key;

entity kabupaten,
  sub place,
  owns kabupaten_name @key;
