define

attribute commodity_name, sub name;

entity commodity @abstract;

entity palm_oil,
  sub commodity,
  owns commodity_name @key @values("PALM OIL");

entity refined_palm_oil,
  sub commodity,
  owns commodity_name @key @values("REFINED PALM OIL");

# If you executed this and want to get back to option a), run:
# 1. undefine palm_oil; refined_palm_oil;
# 2. undefine @abstract from commodity;
# 3. define
#      attribute commodity_name, value string @values("PALM OIL", "REFINED PALM OIL");
#      entity commodity, owns commodity_name @key;
